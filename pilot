#!/usr/bin/env bash
# local-pilot entry point.
#   ./pilot start                          bring up ollama + the local model
#   ./pilot add <model>                    pull a model, apply the tool template, register it
#   ./pilot code [--dir X]                 open the interactive coding agent
#   ./pilot run --dir X --task "..."       run one task headless
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR"
go build -o bin/pilot ./cmd/pilot
exec bin/pilot "$@"
