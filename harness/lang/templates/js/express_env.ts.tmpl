import dotenv from 'dotenv';
import path from 'path';

// Loads environment variables before anything else reads process.env. The harness
// provisions a .env at the project root; in a monorepo the backend runs from
// backend/, so this also loads the root .env one level up. Import this FIRST in
// every entrypoint (index.ts, migrate.ts, seed.ts).
dotenv.config();
dotenv.config({ path: path.resolve(process.cwd(), '../.env') });
