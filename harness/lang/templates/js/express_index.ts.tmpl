import './env';
import express from 'express';
import cors from 'cors';
import fs from 'fs';
import path from 'path';
{{if .has_postgres}}import { pool } from './db';{{end}}{{if and .needs_auth .has_postgres}}
import { authRouter } from './auth';{{end}}

const app = express();

// CORS is open in dev so the Vite frontend (proxied at /api) can call this API.
app.use(cors());
app.use(express.json());

// Health check — also verifies the database connection when Postgres is used.
app.get('/health', async (_req, res) => {
{{if .has_postgres}}  try {
    await pool.query('SELECT 1');
    res.json({ status: 'ok', db: true });
  } catch (err) {
    res.status(503).json({ status: 'degraded', db: false });
  }{{else}}  res.json({ status: 'ok' });{{end}}
});

{{if and .needs_auth .has_postgres}}// Authentication is ready: POST /api/auth/register, POST /api/auth/login, GET /api/auth/me.
app.use('/api/auth', authRouter);
{{end}}// AUTO-MOUNT: every router in ./routes is mounted at /api/<filename> automatically.
// A route module just needs to `export default` an Express Router — it goes live
// by existing, with no manual wiring to forget. Name the file after its resource
// (routes/items.ts -> /api/items) and use relative paths inside it (router.get('/'),
// router.get('/:id'), router.post('/')). Do NOT edit this file.
const routesDir = path.join(__dirname, 'routes');
if (fs.existsSync(routesDir)) {
  for (const file of fs.readdirSync(routesDir).sort()) {
    if (!/\.(t|j)s$/.test(file) || file.endsWith('.d.ts') || /^index\.(t|j)s$/.test(file)) continue;
    const name = file.replace(/\.(t|j)s$/, '');
    try {
      // eslint-disable-next-line @typescript-eslint/no-var-requires
      const mod = require(path.join(routesDir, file));
      const router = mod && (mod.default || mod.router || mod[name + 'Router'] || mod);
      if (typeof router === 'function') {
        app.use('/api/' + name, router);
        console.log('mounted /api/' + name);
      }
    } catch (err) {
      console.error('failed to mount route ' + file + ':', err);
    }
  }
}

const port = process.env.PORT || 3001;
app.listen(port, () => console.log(`API listening on http://localhost:${port}`));
