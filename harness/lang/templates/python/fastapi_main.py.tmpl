def _mount_feature_routers(application: FastAPI) -> None:
    # Auto-mount every feature router so this file never needs editing and can never
    # drift from the route modules. Any .py file ANYWHERE under app/ (at any depth —
    # app/routes/, app/api/, app/api/endpoints/, ...) that defines a module-level
    # `router` is included; a router not already prefixed with /api is mounted beneath
    # /api, so the frontend's /api/... calls always resolve regardless of the prefix
    # the module set. To add an endpoint you only create a module with
    # `router = APIRouter(...)` — do NOT edit this file. A module that fails to import
    # is skipped with a warning (the app still boots on its healthy routes) so one
    # broken feature never takes down the others.
    api = APIRouter(prefix="/api")
    mounted_under_api = False
    app_dir = os.path.dirname(__file__)
    skip = {"main.py", "db.py", "auth.py"}
    for root, dirs, files in os.walk(app_dir):
        dirs[:] = [d for d in dirs if not d.startswith((".", "__"))]
        for name in files:
            if not name.endswith(".py") or name.startswith("_") or name in skip:
                continue
            rel = os.path.relpath(os.path.join(root, name), app_dir)[:-3]
            mod_name = "app." + rel.replace(os.sep, ".")
            try:
                module = importlib.import_module(mod_name)
            except Exception as exc:  # a non-router module or one with an import bug
                print(f"[startup] skipped {mod_name}: {exc}", flush=True)
                continue
            router = getattr(module, "router", None)
            if router is None:
                continue
            if getattr(router, "prefix", "").startswith("/api"):
                application.include_router(router)
            else:
                api.include_router(router)
                mounted_under_api = True
    if mounted_under_api:
        application.include_router(api)


_mount_feature_routers(app)
{{if .needs_auth}}

@app.on_event("startup")
def _startup():
    # Create tables for every model registered on Base (auth + features). Importing
    # the route modules above registered their models, so those tables are created.
    init_db()
